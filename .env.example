# =============================================================================
# FIAT ™ — Faso Info Art Technologie | Variables d'Environnement
# =============================================================================

# Clé API Resend (Obtenez votre clé sur https://resend.com/api-keys)
VITE_RESEND_API_KEY=re_your_resend_api_key_here

# Adresse de réception des messages de contact / devis
VITE_RESEND_TO_EMAIL=contact@fiat.bf

# Adresse d'expédition validée sur Resend (ex: onboarding@resend.dev ou devis@votredomaine.bf)
VITE_RESEND_FROM_EMAIL=onboarding@resend.dev

# Lien d'envoi précis (URL personnalisée, Webhook Discord/Slack, ou endpoint Resend)
# Modifiez ce lien avec l'URL exacte vers laquelle vous souhaitez envoyer les messages
VITE_CONTACT_API_URL=https://api.resend.com/emails
